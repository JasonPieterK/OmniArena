<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.omniarena</groupId>
    <artifactId>OmniArena</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>OmniArena</name>
    <description>Complete PVP Arena Plugin (Paper / Purpur / Spigot / Bukkit, Minecraft 1.21.9 - 26.3)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Defaults = platform "paper" + "mc-26.2". Overridden by the platform / mc-* profiles below. -->
        <platform>paper</platform>
        <mc.version>26.2</mc.version>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <api.version>26.2</api.version>
        <paper.api.version>26.2.build.135-stable</paper.api.version>
        <purpur.api.version>26.2-R0.1-SNAPSHOT</purpur.api.version>
        <spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version>

        <!-- Adventure is only shaded on spigot/bukkit; on paper/purpur the relocation below is an inert no-op. -->
        <adventure.version>4.26.1</adventure.version>
        <adventure.platform.version>4.4.1</adventure.platform.version>
        <kyori.relocate.pattern>omniarena.unused.kyori</kyori.relocate.pattern>
        <kyori.relocate.shaded>omniarena.unused.kyori</kyori.relocate.shaded>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
            <releases><enabled>false</enabled></releases>
        </repository>
        <repository>
            <id>purpurmc</id>
            <url>https://repo.purpurmc.org/snapshots/</url>
        </repository>
        <repository>
            <id>essentials-releases</id>
            <url>https://repo.essentialsx.net/releases/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>sk89q-repo</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
        <repository>
            <id>luckperms</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>vault-repo</id>
            <url>https://nexus.hc.to/content/repositories/pub_releases</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Server API (paper-api / purpur-api / spigot-api) is added by the platform profiles. -->

        <!-- Vault (Economy/Permissions) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
            <exclusions>
                <!-- VaultAPI drags in an ancient bukkit 1.13 that shadows the real server API on the classpath -->
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- WorldGuard -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>7.0.12</version>
            <scope>provided</scope>
        </dependency>

        <!-- LuckPerms -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- FastBoard (Scoreboard Library - shaded) -->
        <dependency>
            <groupId>fr.mrmicky</groupId>
            <artifactId>fastboard</artifactId>
            <version>2.1.3</version>
            <scope>compile</scope>
        </dependency>

        <!-- MySQL Connector (optional database backend) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- HikariCP (connection pool) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.2.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Gson (web dashboard JSON) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- JUnit 5 (tests) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>OmniArena-${platform}-${mc.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createSourcesJar>false</createSourcesJar>
                            <relocations>
                                <relocation>
                                    <pattern>fr.mrmicky.fastboard</pattern>
                                    <shadedPattern>com.omniarena.shaded.fastboard</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>com.omniarena.shaded.hikari</shadedPattern>
                                </relocation>
                                <!-- spigot/bukkit only: shaded Adventure (see profiles); no-op on paper/purpur -->
                                <relocation>
                                    <pattern>${kyori.relocate.pattern}</pattern>
                                    <shadedPattern>${kyori.relocate.shaded}</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ===== Platform profiles ===== -->
        <profile>
            <id>paper</id>
            <!-- Paper: native Adventure, Paper events and chunk APIs (src/paper/java). -->
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <platform>paper</platform>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.papermc.paper</groupId>
                    <artifactId>paper-api</artifactId>
                    <version>${paper.api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-platform-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/paper/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>purpur</id>
            <!-- Purpur is a Paper fork: same code as paper, compiled against purpur-api (repo.purpurmc.org). -->
            <properties>
                <platform>purpur</platform>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.purpurmc.purpur</groupId>
                    <artifactId>purpur-api</artifactId>
                    <version>${purpur.api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-platform-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/paper/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>spigot</id>
            <!-- Spigot: Spigot API only; Adventure shaded + relocated (src/spigot/java). -->
            <properties>
                <platform>spigot</platform>
                <kyori.relocate.pattern>net.kyori</kyori.relocate.pattern>
                <kyori.relocate.shaded>com.omniarena.libs.kyori</kyori.relocate.shaded>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                    <version>${spigot.api.version}</version>
                    <scope>provided</scope>
                </dependency>
                <!-- Adventure + MiniMessage + platform-bukkit: shaded, relocated to com.omniarena.libs.kyori -->
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-api</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-minimessage</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-serializer-legacy</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-serializer-plain</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-platform-bukkit</artifactId><version>${adventure.platform.version}</version><scope>compile</scope></dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-platform-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/spigot/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>bukkit</id>
            <!-- Bukkit/CraftBukkit: identical API to Spigot (spigot-api is the only published Bukkit-flavoured API); same code as spigot, only the jar name differs. -->
            <properties>
                <platform>bukkit</platform>
                <kyori.relocate.pattern>net.kyori</kyori.relocate.pattern>
                <kyori.relocate.shaded>com.omniarena.libs.kyori</kyori.relocate.shaded>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                    <version>${spigot.api.version}</version>
                    <scope>provided</scope>
                </dependency>
                <!-- Adventure + MiniMessage + platform-bukkit: shaded, relocated to com.omniarena.libs.kyori -->
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-api</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-minimessage</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-serializer-legacy</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-serializer-plain</artifactId><version>${adventure.version}</version><scope>compile</scope></dependency>
                <dependency><groupId>net.kyori</groupId><artifactId>adventure-platform-bukkit</artifactId><version>${adventure.platform.version}</version><scope>compile</scope></dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-platform-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/spigot/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ===== Minecraft version profiles ===== -->
        <profile>
            <id>mc-26.3</id>
            <properties>
                <mc.version>26.3</mc.version>
                <java.version>25</java.version>
                <maven.compiler.release>25</maven.compiler.release>
                <api.version>26.3</api.version>
                <paper.api.version>26.3.build.253-stable</paper.api.version>
                <purpur.api.version>26.3-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>26.3-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-26.2</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <mc.version>26.2</mc.version>
                <java.version>25</java.version>
                <maven.compiler.release>25</maven.compiler.release>
                <api.version>26.2</api.version>
                <paper.api.version>26.2.build.135-stable</paper.api.version>
                <purpur.api.version>26.2-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-26.1</id>
            <properties>
                <mc.version>26.1</mc.version>
                <java.version>25</java.version>
                <maven.compiler.release>25</maven.compiler.release>
                <api.version>26.1</api.version>
                <paper.api.version>26.1.2.build.74-stable</paper.api.version>
                <purpur.api.version>26.1.2-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>26.1-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1.21.11</id>
            <properties>
                <mc.version>1.21.11</mc.version>
                <java.version>21</java.version>
                <maven.compiler.release>21</maven.compiler.release>
                <api.version>1.21</api.version>
                <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
                <purpur.api.version>1.21.11-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>1.21.11-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1.21.10</id>
            <properties>
                <mc.version>1.21.10</mc.version>
                <java.version>21</java.version>
                <maven.compiler.release>21</maven.compiler.release>
                <api.version>1.21</api.version>
                <paper.api.version>1.21.10-R0.1-SNAPSHOT</paper.api.version>
                <purpur.api.version>1.21.10-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>1.21.10-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1.21.9</id>
            <properties>
                <mc.version>1.21.9</mc.version>
                <java.version>21</java.version>
                <maven.compiler.release>21</maven.compiler.release>
                <api.version>1.21</api.version>
                <paper.api.version>1.21.9-R0.1-SNAPSHOT</paper.api.version>
                <purpur.api.version>1.21.9-R0.1-SNAPSHOT</purpur.api.version>
                <spigot.api.version>1.21.9-R0.1-SNAPSHOT</spigot.api.version>
            </properties>
        </profile>
    </profiles>
</project>
